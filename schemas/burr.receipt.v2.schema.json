{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Burr receipt v2",
  "type": "object",
  "required": [
    "schema_version",
    "burr_version",
    "outcome",
    "status",
    "artifact_id",
    "artifact_version",
    "artifact_type",
    "rulepack_id",
    "rulepack_version",
    "compatibility",
    "source_design_data",
    "source_manifest",
    "checks",
    "warnings",
    "scope",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "burr.receipt.v2" },
    "burr_version": { "type": "string", "minLength": 1 },
    "status": { "$ref": "#/$defs/outcome" },
    "outcome": { "$ref": "#/$defs/outcome" },
    "artifact_id": { "$ref": "#/$defs/nullable_string" },
    "artifact_version": { "$ref": "#/$defs/nullable_string" },
    "artifact_type": { "$ref": "#/$defs/nullable_string" },
    "rulepack_id": { "$ref": "#/$defs/nullable_string" },
    "rulepack_version": { "$ref": "#/$defs/nullable_string" },
    "compatibility": { "$ref": "#/$defs/compatibility" },
    "source_design_data": { "type": ["string", "null"] },
    "source_manifest": { "type": ["string", "null"] },
    "checks": {
      "type": "array",
      "items": { "$ref": "#/$defs/check" }
    },
    "warnings": {
      "type": "array",
      "items": { "$ref": "#/$defs/warning" }
    },
    "scope": { "$ref": "#/$defs/scope" },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "required": ["outcome"],
        "properties": { "outcome": { "const": "pass" } }
      },
      "then": { "properties": { "status": { "const": "pass" } } }
    },
    {
      "if": {
        "required": ["outcome"],
        "properties": { "outcome": { "const": "incomplete" } }
      },
      "then": { "properties": { "status": { "const": "incomplete" } } }
    },
    {
      "if": {
        "required": ["outcome"],
        "properties": { "outcome": { "const": "fail" } }
      },
      "then": { "properties": { "status": { "const": "fail" } } }
    }
  ],
  "$defs": {
    "outcome": {
      "enum": ["pass", "incomplete", "fail"]
    },
    "nonnegative_integer": {
      "type": "integer",
      "minimum": 0
    },
    "string_list": {
      "type": "array",
      "items": { "type": "string" }
    },
    "nullable_string": {
      "type": ["string", "null"]
    },
    "check": {
      "type": "object",
      "required": ["rule_id", "status", "reason", "message"],
      "properties": {
        "rule_id": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/outcome" },
        "reason": { "type": "string", "minLength": 1 },
        "message": { "type": "string" },
        "feature_id": { "$ref": "#/$defs/nullable_string" },
        "feature_ids": { "$ref": "#/$defs/string_list" },
        "file_ref": { "type": "string" },
        "path": { "type": ["string", "null"] },
        "margin_mm": { "type": "number" },
        "measured": { "type": "object" },
        "required": { "type": "object" },
        "context": { "type": "object" }
      },
      "additionalProperties": true
    },
    "warning": {
      "type": "object",
      "required": ["rule_id", "status", "reason", "message", "affects_outcome"],
      "properties": {
        "rule_id": { "type": "string", "minLength": 1 },
        "status": { "const": "warn" },
        "reason": { "type": "string", "minLength": 1 },
        "message": { "type": "string" },
        "affects_outcome": { "type": "boolean" },
        "feature_ids": { "$ref": "#/$defs/string_list" },
        "measured": { "type": "object" },
        "required": { "type": "object" }
      },
      "additionalProperties": true
    },
    "compatibility": {
      "type": "object",
      "required": [
        "design_data_schema_version",
        "supported_design_data_schema_versions",
        "manifest_schema_version",
        "supported_manifest_schema_versions",
        "rulepack_schema_version",
        "supported_rulepack_schema_versions"
      ],
      "properties": {
        "design_data_schema_version": { "$ref": "#/$defs/nullable_string" },
        "supported_design_data_schema_versions": { "$ref": "#/$defs/string_list" },
        "manifest_schema_version": { "$ref": "#/$defs/nullable_string" },
        "supported_manifest_schema_versions": { "$ref": "#/$defs/string_list" },
        "rulepack_schema_version": { "$ref": "#/$defs/nullable_string" },
        "supported_rulepack_schema_versions": { "$ref": "#/$defs/string_list" }
      },
      "additionalProperties": true
    },
    "scope_target": {
      "type": "object",
      "required": ["design", "rulepack", "compatible"],
      "properties": {
        "design": { "$ref": "#/$defs/nullable_string" },
        "rulepack": { "$ref": "#/$defs/nullable_string" },
        "compatible": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "scope": {
      "type": "object",
      "required": ["artifact_type", "process_kind", "rules", "mechanical_features"],
      "properties": {
        "artifact_type": { "$ref": "#/$defs/scope_target" },
        "process_kind": {
          "allOf": [
            { "$ref": "#/$defs/scope_target" },
            {
              "type": "object",
              "required": ["restricted"],
              "properties": { "restricted": { "type": "boolean" } }
            }
          ]
        },
        "rules": {
          "type": "object",
          "required": [
            "declared",
            "evaluated",
            "evaluated_rule_ids"
          ],
          "properties": {
            "declared": { "$ref": "#/$defs/nonnegative_integer" },
            "evaluated": { "$ref": "#/$defs/nonnegative_integer" },
            "evaluated_rule_ids": { "$ref": "#/$defs/string_list" }
          },
          "additionalProperties": true
        },
        "mechanical_features": {
          "type": "object",
          "required": ["declared", "checked", "unchecked", "unchecked_feature_ids"],
          "properties": {
            "declared": { "$ref": "#/$defs/nonnegative_integer" },
            "checked": { "$ref": "#/$defs/nonnegative_integer" },
            "unchecked": { "$ref": "#/$defs/nonnegative_integer" },
            "unchecked_feature_ids": { "$ref": "#/$defs/string_list" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "rule_summary": {
      "type": "object",
      "required": ["declared", "evaluated"],
      "properties": {
        "declared": { "$ref": "#/$defs/nonnegative_integer" },
        "evaluated": { "$ref": "#/$defs/nonnegative_integer" }
      },
      "additionalProperties": true
    },
    "feature_summary": {
      "type": "object",
      "required": [
        "declared",
        "checked",
        "unchecked",
        "checked_feature_ids",
        "unchecked_feature_ids",
        "mechanical_declared",
        "mechanical_checked",
        "mechanical_unchecked",
        "checked_mechanical_feature_ids",
        "unchecked_mechanical_feature_ids",
        "intent_counts",
        "step_candidate_cylinders_considered"
      ],
      "properties": {
        "declared": { "$ref": "#/$defs/nonnegative_integer" },
        "checked": { "$ref": "#/$defs/nonnegative_integer" },
        "unchecked": { "$ref": "#/$defs/nonnegative_integer" },
        "checked_feature_ids": { "$ref": "#/$defs/string_list" },
        "unchecked_feature_ids": { "$ref": "#/$defs/string_list" },
        "mechanical_declared": { "$ref": "#/$defs/nonnegative_integer" },
        "mechanical_checked": { "$ref": "#/$defs/nonnegative_integer" },
        "mechanical_unchecked": { "$ref": "#/$defs/nonnegative_integer" },
        "checked_mechanical_feature_ids": { "$ref": "#/$defs/string_list" },
        "unchecked_mechanical_feature_ids": { "$ref": "#/$defs/string_list" },
        "intent_counts": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/nonnegative_integer" }
        },
        "step_candidate_cylinders_considered": { "$ref": "#/$defs/nonnegative_integer" }
      },
      "additionalProperties": true
    },
    "summary": {
      "type": "object",
      "required": [
        "checks",
        "failures",
        "incomplete_checks",
        "warnings",
        "rules",
        "features"
      ],
      "properties": {
        "checks": { "$ref": "#/$defs/nonnegative_integer" },
        "failures": { "$ref": "#/$defs/nonnegative_integer" },
        "incomplete_checks": { "$ref": "#/$defs/nonnegative_integer" },
        "warnings": { "$ref": "#/$defs/nonnegative_integer" },
        "rules": { "$ref": "#/$defs/rule_summary" },
        "features": { "$ref": "#/$defs/feature_summary" }
      },
      "additionalProperties": true
    }
  }
}
